# Saturn boot splash.
#
# Everything with a gradient, a rounded corner or letter spacing was rendered
# at build time (see theme.nix) — this only positions sprites and animates a
# few of them. The composition is authored at 1920x1080 and scaled from there.
#
# What this can and cannot show: SetUpdateStatusFunction hands us systemd's
# unit descriptions, so the list under the progress bar reads "Network Manager",
# not a kernel log line with a timestamp. The real console is on ESC.

global.design = 1920;
global.sw = Window.GetWidth();
global.sh = Window.GetHeight();
global.s = global.sw / global.design;
global.ox = Window.GetX();
global.oy = Window.GetY();

# Layout, in design pixels. Shared with greeter/GreeterSurface.qml so the
# handoff from splash to login screen does not move anything.
global.lockupX = 130;
global.lockupY = 286;
global.contentX = 130;
global.contentY = 380;

fun put(file, x, y, z) {
    local.img = Image(file);
    local.img = img.Scale(img.GetWidth() * global.s, img.GetHeight() * global.s);

    local.it.image = img;
    it.sprite = Sprite(img);
    it.sprite.SetX(global.ox + x * global.s);
    it.sprite.SetY(global.oy + y * global.s);
    it.sprite.SetZ(z);

    return it;
}

fun hide(it) {
    it.sprite.SetOpacity(0);
}

fun show(it) {
    it.sprite.SetOpacity(1);
}

# ---------------------------------------------------------------- background

global.bgImage = Image("background.png").Scale(global.sw, global.sh);
global.bg = Sprite(global.bgImage);
global.bg.SetX(global.ox);
global.bg.SetY(global.oy);
global.bg.SetZ(0);

# ------------------------------------------------------------------- lockup

global.lockupBoot = put("lockup-boot.png", global.lockupX, global.lockupY, 10);
global.lockupAuth = put("lockup-unlock.png", global.lockupX, global.lockupY, 10);
hide(global.lockupAuth);

# The spinner sits over the mark, whose centre is 33 design pixels into the
# 66-wide lockup box.
global.ringX = global.lockupX + 33;
global.ringY = global.lockupY + 33;
global.ringFrames = 36;
global.ringIndex = 0;

for (i = 0; i < global.ringFrames; i++) {
    global.ring[i] = Image("ring-" + i + ".png");
    global.ring[i] = global.ring[i].Scale(84 * global.s, 84 * global.s);
}

global.ringSprite = Sprite(global.ring[0]);
global.ringSprite.SetX(global.ox + (global.ringX - 42) * global.s);
global.ringSprite.SetY(global.oy + (global.ringY - 42) * global.s);
global.ringSprite.SetZ(20);

# ------------------------------------------------------------------- header

global.header = put("header.png", global.contentX, global.contentY, 20);
global.headerAuth = put("header-auth.png", global.contentX, global.contentY, 20);
hide(global.headerAuth);

# ------------------------------------------------------------- progress bar

# The bar is barW wide and the sheen strip sheenW; both are needed at draw
# time, since sprites do not clip and the sheen has to be cropped by hand.
global.barW = 520;
global.sheenW = 180;

global.barY = global.contentY + 44;
global.track = put("progress-track.png", global.contentX, global.barY, 20);

global.fillImage = Image("progress-fill.png");
global.fillSprite = Sprite();
global.fillSprite.SetX(global.ox + global.contentX * global.s);
global.fillSprite.SetY(global.oy + global.barY * global.s);
global.fillSprite.SetZ(21);
global.progress = 0;
global.drawnProgress = -1;

global.sheen = put("sheen.png", global.contentX, global.barY, 22);
global.sheenX = 0;

# ---------------------------------------------------------------- log lines

# Newest at the bottom, older ones fading upward. There is no mask primitive,
# so the fade is per-line opacity.
global.logCount = 8;
global.logX = global.contentX;
global.logY = global.contentY + 90;
global.logStep = 22;

for (i = 0; i < global.logCount; i++) {
    global.logSprite[i] = Sprite();
    global.logSprite[i].SetX(global.ox + global.logX * global.s);
    global.logSprite[i].SetY(global.oy + (global.logY + i * global.logStep) * global.s);
    global.logSprite[i].SetZ(15);
    global.logSprite[i].SetOpacity(0);
    global.logText[i] = "";
}

fun pushLog(text) {
    if (text == "" || text == global.logText[global.logCount - 1])
        return;

    # Shift everything up one slot, then draw the new line at the bottom.
    for (i = 0; i < global.logCount - 1; i++)
        global.logText[i] = global.logText[i + 1];

    global.logText[global.logCount - 1] = text;

    for (i = 0; i < global.logCount; i++) {
        if (global.logText[i] == "") {
            global.logSprite[i].SetOpacity(0);
        } else {
            local.img = Image.Text(global.logText[i], 0.55, 0.54, 0.60, 1, "SpaceMono Nerd Font 10");
            global.logSprite[i].SetImage(img);
            # Oldest at 0.15, newest at 1.0.
            global.logSprite[i].SetOpacity(0.15 + 0.85 * i / (global.logCount - 1));
        }
    }
}

# ----------------------------------------------------------- password dialog

global.asking = 0;
global.bulletCount = 0;

global.field = put("field.png", global.contentX, global.contentY + 30, 100);
hide(global.field);

global.caret = put("caret.png", global.contentX + 18, global.contentY + 48, 102);
hide(global.caret);

global.hint = put("hint.png", global.contentX + 470, global.contentY + 52, 102);
hide(global.hint);

global.caps = put("caps.png", global.contentX, global.contentY + 100, 102);
hide(global.caps);

global.bulletImage = Image("bullet.png").Scale(8 * global.s, 8 * global.s);
global.bulletMax = 40;
global.bulletStep = 18;

for (i = 0; i < global.bulletMax; i++) {
    global.bullet[i] = Sprite();
    global.bullet[i].SetX(global.ox + (global.contentX + 18 + i * global.bulletStep) * global.s);
    global.bullet[i].SetY(global.oy + (global.contentY + 54) * global.s);
    global.bullet[i].SetZ(101);
    global.bullet[i].SetOpacity(0);
}

fun drawBullets(count) {
    if (count > global.bulletMax)
        count = global.bulletMax;

    for (i = 0; i < global.bulletMax; i++) {
        if (i < count) {
            global.bullet[i].SetImage(global.bulletImage);
            global.bullet[i].SetOpacity(1);
        } else {
            global.bullet[i].SetOpacity(0);
        }
    }

    global.caret.sprite.SetX(global.ox + (global.contentX + 18 + count * global.bulletStep) * global.s);
}

fun enterAuth() {
    global.asking = 1;

    hide(global.lockupBoot);
    show(global.lockupAuth);
    hide(global.header);
    show(global.headerAuth);

    hide(global.track);
    hide(global.sheen);
    global.fillSprite.SetOpacity(0);

    for (i = 0; i < global.logCount; i++)
        global.logSprite[i].SetOpacity(0);

    show(global.field);
    show(global.caret);
    show(global.hint);
}

fun leaveAuth() {
    global.asking = 0;

    show(global.lockupBoot);
    hide(global.lockupAuth);
    show(global.header);
    hide(global.headerAuth);

    show(global.track);
    show(global.sheen);
    global.fillSprite.SetOpacity(1);
    global.drawnProgress = -1;

    hide(global.field);
    hide(global.caret);
    hide(global.hint);
    hide(global.caps);

    drawBullets(0);
    global.bulletCount = 0;

    for (i = 0; i < global.logCount; i++) {
        if (global.logText[i] != "")
            global.logSprite[i].SetOpacity(0.15 + 0.85 * i / (global.logCount - 1));
    }
}

# ---------------------------------------------------------------- callbacks

global.tick = 0;

fun onRefresh() {
    global.tick++;

    # Spinner: one frame every other tick, so a full turn takes ~1.4s.
    if (global.asking == 0) {
        if (global.tick % 2 == 0) {
            global.ringIndex = (global.ringIndex + 1) % global.ringFrames;
            global.ringSprite.SetImage(global.ring[global.ringIndex]);
        }

        # Sheen sweeps the bar and restarts. Sprites do not clip, so the strip
        # is only ever moved *inside* the track: flush with the left end at
        # x = 0, flush with the right at x = span, and never past either. It
        # used to run from -sheenW to barW instead, which is why it visibly
        # hung off both ends of the bar.
        #
        # Fading it in and out over the first and last stretch is what hides
        # the jump back to the start, and it is done with opacity rather than
        # by cropping the strip: Image.Crop exists in this plymouth, but a
        # sprite drawn from a cropped image did not render here at all, and a
        # progress bar is not the place to find that out on the next reboot.
        local.span = global.barW - global.sheenW;
        local.fade = 70;

        global.sheenX = global.sheenX + 6;
        if (global.sheenX > span)
            global.sheenX = 0;

        local.alpha = 1;

        if (global.sheenX < fade) {
            alpha = global.sheenX / fade;
        } else {
            if (global.sheenX > span - fade)
                alpha = (span - global.sheenX) / fade;
        }

        global.sheen.sprite.SetX(global.ox + (global.contentX + global.sheenX) * global.s);
        global.sheen.sprite.SetOpacity(alpha);

        # Rescaling the fill is the expensive part, so only redraw when the
        # width actually changes.
        local.want = Math.Int(global.progress * global.barW);
        if (want != global.drawnProgress) {
            global.drawnProgress = want;

            if (want < 1)
                want = 1;

            global.fillSprite.SetImage(global.fillImage.Scale(want * global.s, 2 * global.s));
            global.fillSprite.SetOpacity(1);
        }
    } else {
        global.ringSprite.SetOpacity(0);

        # Blink the caret.
        if (global.tick % 30 < 15)
            global.caret.sprite.SetOpacity(1);
        else
            global.caret.sprite.SetOpacity(0);

        if (Plymouth.GetCapslockState())
            show(global.caps);
        else
            hide(global.caps);
    }
}

fun onStatus(status) {
    pushLog(status);
}

fun onProgress(duration, progress) {
    global.progress = progress;
}

fun onPassword(prompt, bullets) {
    if (global.asking == 0)
        enterAuth();

    global.bulletCount = bullets;
    drawBullets(bullets);
}

fun onNormal() {
    if (global.asking == 1)
        leaveAuth();

    global.ringSprite.SetOpacity(1);
}

fun onMessage(text) {
    pushLog(text);
}

fun onQuit() {
    global.bg.SetOpacity(0);
    global.ringSprite.SetOpacity(0);
}

Plymouth.SetRefreshFunction(onRefresh);
Plymouth.SetUpdateStatusFunction(onStatus);
Plymouth.SetBootProgressFunction(onProgress);
Plymouth.SetDisplayPasswordFunction(onPassword);
Plymouth.SetDisplayNormalFunction(onNormal);
Plymouth.SetMessageFunction(onMessage);
Plymouth.SetQuitFunction(onQuit);
