pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Services.Greetd
import qs.core

// The whole conversation with greetd, kept out of the views so the login
// screen can be laid out without knowing anything about PAM.
Singleton {
    id: root

    // Everything the greeter needs to know about the machine it is logging
    // into, generated by modules/sys/greeter/default.nix. It arrives in a file
    // rather than baked into QML because this tree is also mirrored into
    // ~/nixos for hot reload, and store paths must not leak into it.
    //
    // Assigned field by field in applyConfig rather than derived from a single
    // `config` object with bindings. Those bindings are not guaranteed to have
    // re-evaluated by the time the change handler that consumes them runs, and
    // reading a stale username here is not a visible bug: greetd is asked about
    // a user that does not exist, PAM says "user unknown", and the screen
    // reports it as a wrong password forever.
    property bool configLoaded: false

    property string user: "user"
    property string nixosRelease: ""
    property string keymap: ""
    property var sessions: []

    function applyConfig(cfg) {
        root.user = cfg.user ?? "user";
        root.nixosRelease = cfg.nixosRelease ?? "";
        root.keymap = cfg.keymap ?? "";
        root.sessions = cfg.sessions ?? [];
        root.configLoaded = true;

        root.applyRemembered();
        root.start();
    }

    property int sessionIndex: 0
    readonly property var session: root.sessions.length > 0 ? root.sessions[root.sessionIndex % root.sessions.length] : null
    readonly property string sessionLabel: root.session?.label ?? "session"

    // The id picked last time, from the greeter's own home. Without it the
    // index resets on every boot, so choosing GNOME once and rebooting drops
    // you back into Hyprland with no indication that anything was ignored.
    //
    // The file and the session list arrive independently and in either order,
    // so both paths call applyRemembered and it does nothing until it has both.
    property string rememberedSession: ""

    function applyRemembered() {
        if (!root.configLoaded || root.rememberedSession === "")
            return;

        for (let i = 0; i < root.sessions.length; i++) {
            if (root.sessions[i].id === root.rememberedSession) {
                root.sessionIndex = i;
                return;
            }
        }

        // A session that has since been removed from the system: fall through
        // to index 0, which modules/sys/greeter sorts to be the default.
    }

    // greetd is only reachable from inside the greeter session. Running this
    // file with `qs -p` on a normal desktop leaves it unavailable, which is
    // what dev mode keys off: the screen stays fully interactive so the visuals
    // can be worked on without logging out. The password is "test" there.
    readonly property bool live: Greetd.available

    // idle -> prompting -> checking -> launching, with failed as a dead end
    // that clears itself. `prompting` is the only phase that takes input.
    property string phase: "idle"
    property string message: ""

    // PAM decides whether what it asked for is a secret. Rendering bullets for
    // a prompt that wanted echo is how greeters end up looking hung.
    property bool echoResponse: false

    property string response: ""

    readonly property bool busy: root.phase === "checking" || root.phase === "launching"
    readonly property bool failed: root.phase === "failed"

    // Reads as "gen 112" under the clock. Purely informational, but it is the
    // one number that tells you which rebuild you are about to boot into.
    property int generation: 0

    // greetd has to be asked for a session for a *named* user, and that name
    // arrives asynchronously from the file below. Starting before it lands asks
    // PAM about the fallback name and gets "user unknown" — which the screen
    // reports as a failed password, so the mistake is invisible from the front.
    function start() {
        if (root.configLoaded && root.phase === "idle")
            root.begin();
    }

    function begin() {
        root.response = "";
        root.message = "";

        if (!root.live) {
            root.phase = "prompting";
            root.echoResponse = false;
            return;
        }

        root.phase = "checking";
        Greetd.createSession(root.user);
    }

    function submit() {
        if (root.phase !== "prompting")
            return;

        if (!root.live) {
            // Mirror the real failure path so the shake and the recovery timer
            // can be seen without a reboot.
            if (root.response === "test") {
                root.phase = "launching";
            } else {
                root.phase = "failed";
                root.message = "Authentication failure";
                root.response = "";
                retry.restart();
            }
            return;
        }

        root.phase = "checking";
        Greetd.respond(root.response);
        root.response = "";
    }

    function cycleSession() {
        if (root.sessions.length <= 1)
            return;

        root.sessionIndex = (root.sessionIndex + 1) % root.sessions.length;

        // Best effort. Under `qs -p` this file is not writable and the save
        // fails, which is fine — remembering a choice is not worth a visible
        // error on a screen whose whole job is to accept a password.
        lastSession.setText(root.session?.id ?? "");
    }

    Connections {
        target: Greetd
        enabled: root.live

        function onAuthMessage(message, error, responseRequired, echoResponse) {
            root.message = message;

            if (responseRequired) {
                root.echoResponse = echoResponse;
                root.phase = "prompting";
            }
        }

        function onAuthFailure(message) {
            root.message = message;
            root.response = "";
            root.phase = "failed";
            retry.restart();
        }

        function onReadyToLaunch() {
            root.phase = "launching";

            if (root.session)
                Greetd.launch(root.session.command, root.session.environment ?? [], true);
        }

        function onError(error) {
            root.message = error;
            root.phase = "failed";
            retry.restart();
        }
    }

    // greetd will not take a second password on a session that already failed,
    // so recovery means throwing the session away and asking for a new one.
    Timer {
        id: retry

        interval: Style.duration * 4

        onTriggered: {
            if (root.live)
                Greetd.cancelSession();

            root.begin();
        }
    }

    FileView {
        id: sessionConfig

        path: "/etc/greetd/sessions.json"

        onLoaded: root.applyConfig(JSON.parse(sessionConfig.text()))

        // Running under `qs -p` on a machine that has not been rebuilt yet is
        // normal, so fall back rather than failing to render.
        onLoadFailed: root.applyConfig({
            user: Quickshell.env("USER") ?? "user",
            nixosRelease: "",
            keymap: "us",
            // More than one, so the session chip is interactive here too —
            // otherwise the one control on the screen cannot be exercised
            // without rebuilding and logging out.
            sessions: [
                {
                    id: "dev-hyprland",
                    label: "Hyprland (uwsm-managed)",
                    command: ["true"],
                    environment: []
                },
                {
                    id: "dev-gnome",
                    label: "GNOME",
                    command: ["true"],
                    environment: []
                }
            ]
        })
    }

    // /var/lib/greeter is the greeter user's own home, created 0700 by
    // modules/sys/greeter, so this is the one place on the system it can write.
    FileView {
        id: lastSession

        path: "/var/lib/greeter/last-session"

        atomicWrites: true

        // Missing on a machine that has never had a session picked, and
        // unwritable when run as hcabel for design work. Neither is worth a
        // warning on the console.
        printErrors: false

        onLoaded: {
            root.rememberedSession = lastSession.text().trim();
            root.applyRemembered();
        }
    }

    Process {
        running: true

        command: ["readlink", "/nix/var/nix/profiles/system"]

        stdout: StdioCollector {
            // "system-112-link"
            onStreamFinished: {
                const m = /system-(\d+)-link/.exec(this.text);

                if (m)
                    root.generation = Number(m[1]);
            }
        }
    }

    // applyConfig calls start() itself; this covers the case where the file
    // somehow loaded before this component finished being created.
    Component.onCompleted: root.start()
}
